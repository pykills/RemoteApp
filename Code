# TERMINAL
# ============================================================

def open_terminal():
    try:
        subprocess.Popen(
            ["cmd.exe"],
            creationflags=subprocess.CREATE_NEW_CONSOLE
        )
    except Exception:
        show_not_found("Terminal")


def open_terminal_admin():
    try:
        subprocess.Popen([
            "powershell.exe",
            "-NoProfile",
            "-Command",
            'Start-Process "cmd.exe" -Verb RunAs'
        ])
    except Exception:
        show_not_found("Terminal (Admin)")


