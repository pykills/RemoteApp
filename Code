def show_not_found(program):
    window = tk.Toplevel(root)
    window.title("RemoteApp")
    window.geometry("430x230")
    window.configure(bg="#0d0d0d")
    window.resizable(False, False)

    tk.Label(
        window,
        text="Whoops!",
        font=("Consolas", 25, "bold"),
        fg="#ff4444",
        bg="#0d0d0d"
    ).pack(pady=(25, 10))

    tk.Label(
        window,
        text=f"Programm Not Found\n\n{program}\n\nPlease Try Again.",
        font=("Consolas", 11),
        fg="white",
        bg="#0d0d0d",
        justify="center"
    ).pack()

    tk.Button(
        window,
        text="OK",
        command=window.destroy,
        font=("Consolas", 11),
        fg="white",
        bg="#181818",
        activebackground="#292929",
        activeforeground="#00ff66",
        relief="flat",
        width=12
    ).pack(pady=15)


# ============================================================
# EXE STARTEN
# ============================================================

def launch_exe(program_name, path):
    try:
        if os.path.isabs(path):
            if not os.path.isfile(path):
                show_not_found(program_name)
                return

            subprocess.Popen([path])
            return

        found = shutil.which(path)

        if found is None:
            show_not_found(program_name)
            return

        subprocess.Popen([found])

    except Exception:
        show_not_found(program_name)


# ============================================================
# URI STARTEN
# ============================================================

def launch_uri(program_name, uri):
    try:
        os.startfile(uri)
    except Exception:
        show_not_found(program_name)


# ============================================================
# CHROME
# ============================================================

def open_chrome():
    paths = [
        r"C:\Program Files\Google\Chrome\Application\chrome.exe",
        r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe",
        os.path.expandvars(
            r"%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe"
        )
    ]

    for path in paths:
        if os.path.isfile(path):
            try:
                subprocess.Popen([path])
                return
            except Exception:
                pass

    show_not_found("Google Chrome")


